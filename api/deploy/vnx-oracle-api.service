[Unit]
Description=vnxORACLE Web API (Sales Consultant)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/vnxORACLE_system/api
Environment="PATH=/opt/vnxORACLE_system/api/venv/bin"
ExecStart=/opt/vnxORACLE_system/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=10
StandardOutput=append:/var/log/vnxoracle-api/output.log
StandardError=append:/var/log/vnxoracle-api/error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
