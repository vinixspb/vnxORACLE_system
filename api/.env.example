# OpenRouter API Keys
OPENROUTER_API_KEY_START=sk-or-v1-...
OPENROUTER_API_KEY_PRO=sk-or-v1-...
OPENROUTER_API_KEY_NEO=sk-or-v1-...

# Google Sheets CRM
GOOGLE_CREDENTIALS_JSON=path/to/service-account-credentials.json
SPREADSHEET_ID=your_google_sheet_id_here

# Telegram Notifications
BOT_TOKEN_ORACLE=123456789:ABC...
ADMIN_ID=123456789

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8010
CORS_ORIGINS=https://vinixspb.github.io,http://localhost:5173

# Rate Limiting (защита от накрутки токенов)
# Запросов с одного IP за окно
RATE_LIMIT_REQUESTS=20
# Длина окна в секундах
RATE_LIMIT_WINDOW=60
# Максимум сообщений на сессию (0 = без лимита)
MAX_MESSAGES_PER_SESSION=40
# Максимальная длина сообщения в символах
MAX_MESSAGE_LENGTH=2000

# AI Configuration
DEFAULT_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.7
TEXT_BASE_URL=https://openrouter.ai/api/v1
